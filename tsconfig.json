{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "openclaw/plugin-sdk/*": ["./node_modules/openclaw/dist/plugin-sdk/*"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
